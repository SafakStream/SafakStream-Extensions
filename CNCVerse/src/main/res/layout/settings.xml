<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose studios"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/studio_disney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/studio_disney_cb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disney+"
                android:textSize="16sp"
                android:paddingStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studio_marvel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/studio_marvel_cb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marvel"
                android:textSize="16sp"
                android:paddingStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studio_pixar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/studio_pixar_cb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pixar"
                android:textSize="16sp"
                android:paddingStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studio_starwars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/studio_starwars_cb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Star Wars"
                android:textSize="16sp"
                android:paddingStart="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/clearCacheBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear cache"
            android:layout_marginTop="16dp" />

        <ImageView
            android:id="@+id/save_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/save_icon"
            android:layout_gravity="end"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
